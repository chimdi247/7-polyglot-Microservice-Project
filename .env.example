# =============================================================================
# DevOps Shack Polyglot Microservices — environment configuration
#
# Optional. docker-compose.yml works out of the box with no .env file at
# all — every variable below has a working default. Copy this file only if
# you want to change host ports:
#   cp .env.example .env
#
# Database credentials (microapp / microapp123) are NOT here on purpose —
# they're fixed in docker-compose.yml AND baked into
# docker/postgres/init/*.sql. Changing one without the other two breaks the
# stack; see README.docker.md if you need to change them.
# =============================================================================

# POSTGRES_PORT=5432
# AUTH_SERVICE_PORT=8081
# CATALOG_SERVICE_PORT=8082
# INVENTORY_SERVICE_PORT=8083
# ORDER_SERVICE_PORT=8084
# PAYMENT_SERVICE_PORT=8085
# NOTIFICATION_SERVICE_PORT=8086
# ANALYTICS_SERVICE_PORT=8087
# FRONTEND_PORT=5173
